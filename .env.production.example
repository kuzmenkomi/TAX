# ============================================================
# TaxFlow — Production Environment Template
# Copy to .env.production and fill in ALL values.
# NEVER commit .env.production to git.
# ============================================================

# ─── App ────────────────────────────────────────────────────
APP_ENV=production
DOMAIN=yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ─── Database ───────────────────────────────────────────────
# Use a strong, unique password (e.g. openssl rand -hex 32)
POSTGRES_USER=taxuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tax_app_db

# PostgreSQL URL is auto-constructed in docker-compose, but
# set it here for standalone / manual use:
DATABASE_URL=postgresql://taxuser:CHANGE_ME_STRONG_PASSWORD@localhost:5432/tax_app_db

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ─── Security ───────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MIN_64_CHARS
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_ENCRYPTION_KEY

# ─── Frontend ───────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
FRONTEND_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com

# ─── Monitoring (Sentry) ────────────────────────────────────
# Create project at https://sentry.io
SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/YOUR_PROJECT_ID
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# ─── Email (Brevo) ──────────────────────────────────────────
# Get key at https://app.brevo.com → SMTP & API
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY
BREVO_FROM_EMAIL=noreply@yourdomain.com

# ─── Payments (Stripe) ──────────────────────────────────────
# Use LIVE keys for production (sk_live_...)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_PRO=price_YOUR_PRO_PRICE_ID
STRIPE_PRICE_BUSINESS=price_YOUR_BUSINESS_PRICE_ID
