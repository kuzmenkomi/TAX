# Development Environment
APP_ENV=development

# Database
DATABASE_URL=sqlite:///./tax_app.db

# Security
# Generate both values with backend/scripts/generate_secrets.py before use.
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# Brevo Email Service
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@example.com

# Frontend URLs for email links
FRONTEND_URL=http://localhost:5173

# Frontend CORS origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174

# Coinbase OAuth
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# Blockchain Explorer API Keys (optional but recommended)
# Get free keys at: etherscan.io, bscscan.com, polygonscan.com
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Error Tracking (optional)
# SENTRY_DSN=
