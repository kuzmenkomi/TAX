# ============================================================
# Declairo - Staging Environment Template
# Copy to .env.staging and fill in ALL values before deploy.
# NEVER commit .env.staging to git.
# ============================================================

# --- App ---
APP_ENV=staging
DOMAIN=staging.example.com
ADMIN_EMAIL=ops@example.com

# --- Database ---
POSTGRES_USER=taxuser
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=tax_app_staging
DATABASE_URL=postgresql://taxuser:CHANGE_ME_STAGING_POSTGRES_PASSWORD@postgres:5432/tax_app_staging

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STAGING_REDIS_PASSWORD@redis:6379/0

# --- Security ---
JWT_SECRET_KEY=CHANGE_ME_STAGING_JWT_SECRET_KEY_MIN_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_STAGING_FERNET_KEY
COOKIE_DOMAIN=

# --- Frontend ---
FRONTEND_URL=https://staging.example.com
FRONTEND_ORIGINS=https://staging.example.com

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# --- Email ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@staging.example.com

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- OAuth / Integrations ---
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
